# Local-only development token. Replace before exposing this stack outside loopback.
LOCAL_ADMIN_TOKEN=replace-with-a-long-random-local-token

# Defaults avoid common local OrbStack services on 8080/8081.
SUBSTANCE_ATLAS_POSTGRES_PORT=15432
SUBSTANCE_ATLAS_SERVER_PORT=18080
SUBSTANCE_ATLAS_WEB_PORT=18081
